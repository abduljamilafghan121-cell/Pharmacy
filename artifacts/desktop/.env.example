# Your api-server is deployed together with the web app on Vercel — the
# desktop app talks to it over the internet (no localhost server here),
# so this must be an absolute URL: the bare origin, with NO trailing
# /api — the generated API client already adds /api to every request.
#
# Example: https://your-pharmacy-app.vercel.app
VITE_API_URL=https://YOUR-APP.vercel.app

# For local development against `pnpm --filter @workspace/api-server dev`:
# VITE_API_URL=http://localhost:4000
