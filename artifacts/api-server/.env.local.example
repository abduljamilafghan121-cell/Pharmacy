# ──────────────────────────────────────────────────────────────────────────────
# PharmaCore API Server — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Required for live password-reset email delivery.
# Without these, the reset link is returned directly in the API response (dev only).
#
# GMAIL_USER – the Gmail address used as the sender (enable 2-FA on this account)
# GMAIL_PASS – a Gmail App Password (NOT your account password).
#   Generate one at: https://myaccount.google.com/apppasswords
#   Steps: Security → 2-Step Verification → App passwords → Mail → Other → "PharmaCore"
GMAIL_USER=noreply@yourpharmacy.com
GMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# ── App URL ───────────────────────────────────────────────────────────────────
# The public base URL of the web front-end — used in password-reset links.
# e.g. https://your-project.vercel.app, or your own custom domain.
# Required in production — without it, password-reset emails can't be sent.
APP_URL=https://your-deployed-app.com

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED. The server REFUSES TO START without it — it signs and verifies
# every JWT. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Set the same value in Vercel/your hosting environment as JWT_SECRET.
JWT_SECRET=a-long-random-secret-at-least-32-characters

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allow-list of origins that may call the API cross-origin.
# Same-origin web requests and non-browser clients need nothing here.
# The Electron desktop app (file://) sends "Origin: null" and is allowed by
# default; set CORS_ALLOW_NULL_ORIGIN=false to block it.
# CORS_ORIGINS=https://pharmacy.example.com,https://app.example.com
# CORS_ALLOW_NULL_ORIGIN=true

# ── Database ──────────────────────────────────────────────────────────────────
# Set via SUPABASE_DATABASE_URL (see lib/db) or DATABASE_URL, depending on
# your hosting provider's convention.
# DATABASE_URL=postgres://...
