# ──────────────────────────────────────────────────────────────────────────────
# PharmaCore API Server — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Required for live password-reset email delivery.
# Without these, the reset link is returned directly in the API response (dev only).
#
# GMAIL_USER – the Gmail address used as the sender (enable 2-FA on this account)
# GMAIL_PASS – a Gmail App Password (NOT your account password).
#   Generate one at: https://myaccount.google.com/apppasswords
#   Steps: Security → 2-Step Verification → App passwords → Mail → Other → "PharmaCore"
GMAIL_USER=noreply@yourpharmacy.com
GMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# ── App URL ───────────────────────────────────────────────────────────────────
# The public base URL of the web front-end — used in password-reset links.
# On Replit: your deployed URL, e.g. https://pharmacore.replit.app
# On Vercel: https://your-project.vercel.app
# In local dev: leave unset and the server falls back to REPLIT_DEV_DOMAIN / localhost:5173
APP_URL=https://your-deployed-app.com

# ── Auth ──────────────────────────────────────────────────────────────────────
SESSION_SECRET=a-long-random-secret-at-least-32-characters

# ── Database (managed by Replit — do not set manually in Replit environment) ──
# DATABASE_URL=postgres://...
